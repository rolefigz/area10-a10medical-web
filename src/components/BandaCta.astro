---
// Banda finale di invito all'azione. In Area10 è un poster nero con le curve di livello,
// in A10 Medical è turchese chiaro con la carta millimetrata.
import Icona from './Icona.astro';
import { url } from '../lib/url.js';
import { centro } from '../lib/dati.js';

interface Props {
  area: 'fitness' | 'medical';
  titolo: string;
  testo: string;
}
const { area, titolo, testo } = Astro.props;
const fitness = area === 'fitness';
---

<section
  class:list={['banda', fitness ? 'texture-topo' : 'texture-mm']}
  data-surface={fitness ? 'ink' : undefined}
  data-area={fitness ? undefined : 'medical'}
  aria-label="Contattaci"
>
  <div class="contenitore banda__griglia">
    <div>
      <h2 class="banda__titolo">{titolo}</h2>
      <p class="banda__testo">{testo}</p>
    </div>
    <div class="banda__azioni">
      {
        fitness ? (
          <>
            <a class="btn" href={url('/contatti/#prova')}>
              Prenota la prova gratuita
            </a>
            <a class="btn btn--secondario" href={`tel:${centro.area10.telefono}`}>
              <Icona nome="phone" />
              {centro.area10.telefonoLeggibile}
            </a>
          </>
        ) : (
          <>
            <a class="btn" href={`tel:${centro.medical.telefono}`}>
              <Icona nome="phone" />
              Chiama {centro.medical.telefonoLeggibile}
            </a>
            <a class="btn btn--secondario" href={`mailto:${centro.medical.email}`}>
              <Icona nome="mail" />
              Scrivi una email
            </a>
          </>
        )
      }
    </div>
  </div>
</section>

<style>
  .banda {
    --topo-opacita: 0.18;
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }
  .banda[data-area='medical'] {
    background-color: var(--sfondo-2);
  }
  .banda__griglia {
    display: grid;
    gap: 2rem;
    align-items: end;
  }
  .banda__titolo {
    font-size: var(--step-5);
  }
  .banda__testo {
    max-width: 36rem;
    margin-top: 1rem;
    font-size: var(--step-1);
    color: var(--testo-2);
  }
  .banda__azioni {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (min-width: 64em) {
    .banda__griglia {
      grid-template-columns: 1.4fr 1fr;
      gap: 4rem;
    }
    .banda__azioni {
      justify-content: flex-end;
    }
  }
</style>
