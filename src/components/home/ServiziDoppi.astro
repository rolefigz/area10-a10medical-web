---
// I servizi delle due aree affiancati, separati dallo stesso taglio diagonale dell'hero.
import Icona from '../Icona.astro';
import { url } from '../../lib/url.js';
import { servizi } from '../../lib/dati.js';
---

<section class="servizi" aria-labelledby="servizi-titolo">
  <h2 id="servizi-titolo" class="visually-hidden">I servizi di Area10 e A10 Medical</h2>

  <div class="servizi__meta servizi__meta--fitness" data-area="fitness">
    <div class="servizi__colonna">
      <header class="servizi__testa">
        <h3 class="servizi__area">Area10 Fitness Club</h3>
        <p class="servizi__sotto">Palestra e training, via Formaleoni 6</p>
      </header>
      <ul class="servizi__lista" role="list">
        {
          servizi.area10.map((s) => (
            <li>
              <a href={url(`/area10/#${s.id}`)} class="servizio">
                <Icona nome={s.icona} class="servizio__icona" />
                <span class="servizio__nome">{s.nome}</span>
                <span class="servizio__breve">{s.breve}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn servizi__cta" href={url('/area10/')}>Scopri Area10</a>
    </div>
  </div>

  <div class="servizi__meta servizi__meta--medical" data-area="medical">
    <div class="servizi__colonna">
      <header class="servizi__testa">
        <h3 class="servizi__area">A10 Medical</h3>
        <p class="servizi__sotto">Poliambulatorio, via Formaleoni 8</p>
      </header>
      <ul class="servizi__lista" role="list">
        {
          servizi.medical.map((s) => (
            <li>
              <a href={url(`/medical/#${s.id}`)} class="servizio">
                <Icona nome={s.icona} class="servizio__icona" />
                <span class="servizio__nome">{s.nome}</span>
                <span class="servizio__breve">{s.breve}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn servizi__cta" href={url('/medical/')}>Scopri A10 Medical</a>
    </div>
  </div>
</section>

<style>
  .servizi {
    display: grid;
  }
  .servizi__meta {
    padding-block: var(--sezione);
  }
  .servizi__meta--fitness {
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 calc(100% - var(--taglio)));
    padding-bottom: calc(var(--sezione) + var(--taglio));
  }
  .servizi__meta--medical {
    margin-top: calc(-1 * var(--taglio));
    padding-top: calc(var(--sezione) + var(--taglio));
  }
  .servizi__colonna {
    width: min(100% - 2 * var(--gutter), 38rem);
    margin-inline: auto;
  }
  .servizi__testa {
    display: grid;
    gap: 0.35rem;
    margin-bottom: 1.75rem;
  }
  .servizi__area {
    font-size: var(--step-4);
  }
  .servizi__sotto {
    color: var(--testo-2);
  }

  .servizi__lista {
    display: grid;
    gap: 0.25rem;
    margin: 0 -0.75rem;
    padding: 0;
  }
  .servizio {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1rem;
    row-gap: 0.15rem;
    padding: 0.85rem 0.75rem;
    border-radius: var(--raggio);
    text-decoration: none;
    transition: background-color 200ms ease;
  }
  .servizio :global(.servizio__icona) {
    grid-row: 1 / span 2;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.55rem;
    color: var(--accento-testo);
    background-color: color-mix(in srgb, var(--accento) 16%, transparent);
    border-radius: var(--raggio);
  }
  .servizi__meta--fitness .servizio :global(.servizio__icona) {
    clip-path: polygon(14% 0, 100% 0, 86% 100%, 0 100%);
    padding-inline: 0.7rem;
  }
  .servizio__nome {
    align-self: end;
    font-weight: 750;
    font-size: 1.1rem;
    line-height: 1.25;
  }
  .servizi__meta--fitness .servizio__nome {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: 0.015em;
    text-transform: uppercase;
  }
  .servizio__breve {
    color: var(--testo-2);
    font-size: var(--step--1);
    line-height: 1.45;
  }
  @media (hover: hover) and (pointer: fine) {
    .servizio:hover {
      background-color: color-mix(in srgb, var(--accento) 8%, transparent);
    }
    .servizio:hover .servizio__nome {
      text-decoration: underline;
      text-decoration-color: var(--accento);
      text-decoration-thickness: 2px;
      text-underline-offset: 0.2em;
    }
  }
  .servizi__cta {
    margin-top: 2rem;
  }

  /* Desktop: le due metà affiancate con il taglio diagonale verticale */
  @media (min-width: 64em) {
    .servizi {
      grid-template-columns: 1fr 1fr;
    }
    .servizi__meta {
      grid-row: 1;
      padding-block: var(--sezione);
    }
    .servizi__meta--fitness {
      grid-column: 1 / 2;
      clip-path: polygon(0 0, 100% 0, calc(100% - var(--taglio) * 1.6) 100%, 0 100%);
      margin-right: calc(-1 * var(--taglio) * 1.6);
      padding-right: calc(var(--taglio) * 1.6);
      padding-bottom: var(--sezione);
      z-index: 1;
    }
    .servizi__meta--medical {
      grid-column: 2 / 3;
      margin-top: 0;
      padding-top: var(--sezione);
    }
    .servizi__colonna {
      width: min(100% - 2 * var(--gutter), 34rem);
    }
    .servizi__meta--fitness .servizi__colonna {
      margin-inline: auto calc(var(--gutter) + 1rem);
    }
    .servizi__meta--medical .servizi__colonna {
      margin-inline: calc(var(--taglio) * 1.6 + var(--gutter)) auto;
    }
  }
</style>
