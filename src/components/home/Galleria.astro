---
// Galleria a griglia irregolare: sette spazi per sette foto reali (vedi data/foto.json).
import Foto from '../Foto.astro';

const celle = [
  { id: 'area10/sala-pesi', classe: 'g-a' },
  { id: 'medical/fisioterapia', classe: 'g-b' },
  { id: 'area10/spinning', classe: 'g-c' },
  { id: 'medical/palestra-fisioterapica', classe: 'g-d' },
  { id: 'area10/funzionale', classe: 'g-e' },
  { id: 'medical/lettino', classe: 'g-f' },
  { id: 'area10/pilates', classe: 'g-g' },
];
---

<section class="galleria sezione" aria-labelledby="galleria-titolo">
  <div class="contenitore">
    <h2 id="galleria-titolo" class="galleria__titolo">Dentro Area10 e A10 Medical</h2>
    <div class="galleria__griglia">
      {
        celle.map((c) => (
          <div class:list={['galleria__cella', c.classe]}>
            <Foto id={c.id} riempi sizes="(min-width: 64em) 33vw, 50vw" />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .galleria {
    padding-top: 0;
  }
  .galleria__titolo {
    margin-bottom: 2rem;
    font-size: var(--step-4);
    letter-spacing: -0.035em;
  }
  .galleria__griglia {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 9.5rem;
    gap: 0.5rem;
  }
  .galleria__cella {
    min-width: 0;
  }
  .g-a {
    grid-column: 1 / -1;
    grid-row: span 2;
  }
  .g-b {
    grid-row: span 2;
  }
  .g-e {
    grid-column: 1 / -1;
  }

  @media (min-width: 48em) {
    .galleria__griglia {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-auto-rows: clamp(9rem, 14vw, 13rem);
      gap: 0.75rem;
    }
    .g-a {
      grid-column: 1 / 4;
      grid-row: 1 / 3;
    }
    .g-b {
      grid-column: 4 / 6;
      grid-row: 1 / 3;
    }
    .g-c {
      grid-column: 6 / 7;
      grid-row: 1 / 2;
    }
    .g-d {
      grid-column: 6 / 7;
      grid-row: 2 / 3;
    }
    .g-e {
      grid-column: 1 / 3;
      grid-row: 3 / 4;
    }
    .g-f {
      grid-column: 3 / 5;
      grid-row: 3 / 4;
    }
    .g-g {
      grid-column: 5 / 7;
      grid-row: 3 / 4;
    }
  }
</style>
