---
// Impaginazione comune per privacy e cookie: testo lungo, leggibile, con i campi da completare evidenziati.
import Base from '../layouts/Base.astro';
import Briciole from './Briciole.astro';
import Icona from './Icona.astro';

interface Props {
  titolo: string;
  descrizione: string;
  percorso: string;
  nome: string;
}
const { titolo, descrizione, percorso, nome } = Astro.props;
const briciole = [
  { nome: 'Home', url: '/' },
  { nome, url: percorso },
];
---

<Base titolo={titolo} descrizione={descrizione} briciole={briciole}>
  <article class="legale contenitore">
    <Briciole voci={briciole} />
    <h1 class="legale__titolo">{nome}</h1>
    <p class="legale__bozza">
      <Icona nome="alert-circle" />
      <span>
        Bozza da completare con i dati dei titolari e da far verificare a un consulente privacy prima della
        pubblicazione. Le parti evidenziate sono da compilare.
      </span>
    </p>
    <div class="legale__testo">
      <slot />
    </div>
  </article>
</Base>

<style>
  .legale {
    max-width: 48rem;
    padding-block: clamp(1.25rem, 3vw, 2rem) var(--sezione);
  }
  .legale__titolo {
    margin: 1rem 0 1.5rem;
    font-size: var(--step-5);
    letter-spacing: -0.04em;
  }
  .legale__bozza {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 1rem 1.15rem;
    border-left: 3px solid var(--oro);
    background-color: var(--sfondo-2);
    font-size: var(--step--1);
  }
  .legale__bozza :global(svg) {
    width: 1.35rem;
    height: 1.35rem;
    flex: none;
  }
  .legale__testo {
    margin-top: 2.5rem;
    line-height: 1.7;
  }
  .legale__testo :global(> * + *) {
    margin-top: 1em;
  }
  .legale__testo :global(h2) {
    margin-top: 2.2em;
    font-size: var(--step-2);
    letter-spacing: -0.02em;
  }
  .legale__testo :global(ul) {
    display: grid;
    gap: 0.4em;
    padding-left: 1.3em;
  }
  .legale__testo :global(.da-completare) {
    padding: 0.05em 0.35em;
    border-radius: 0.25em;
    background-color: color-mix(in srgb, var(--oro) 35%, transparent);
    font-weight: 650;
  }
</style>
