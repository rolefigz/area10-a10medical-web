---
// Domande frequenti con <details> nativo: accessibile da tastiera, funziona anche senza JavaScript.
interface Props {
  domande: { domanda: string; risposta: string }[];
  titolo?: string;
}
const { domande, titolo = 'Domande frequenti' } = Astro.props;
---

<div class="domande">
  <h2 class="domande__titolo">{titolo}</h2>
  <div class="domande__elenco">
    {
      domande.map((d) => (
        <details class="domanda">
          <summary>
            <span>{d.domanda}</span>
            <span class="domanda__segno" aria-hidden="true" />
          </summary>
          <p class="domanda__risposta">{d.risposta}</p>
        </details>
      ))
    }
  </div>
</div>

<style>
  .domande {
    display: grid;
    gap: 1.75rem;
  }
  .domande__titolo {
    font-size: var(--step-4);
  }
  .domande__elenco {
    border-top: 1px solid var(--linea-forte);
  }
  .domanda {
    border-bottom: 1px solid var(--linea);
  }
  .domanda summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 3.75rem;
    padding: 1rem 0;
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
  }
  .domanda summary::-webkit-details-marker {
    display: none;
  }
  .domanda__segno {
    position: relative;
    width: 1rem;
    height: 1rem;
    flex: none;
  }
  .domanda__segno::before,
  .domanda__segno::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 2px;
    margin-top: -1px;
    background-color: var(--accento-testo);
    transition: transform 240ms var(--ease-out);
  }
  .domanda__segno::after {
    transform: rotate(90deg);
  }
  .domanda[open] .domanda__segno::after {
    transform: rotate(0deg);
  }
  .domanda__risposta {
    max-width: 62ch;
    padding: 0 0 1.25rem;
    color: var(--testo-2);
  }
</style>
