---
// Barra fissa in basso su smartphone: "Chiama" e "Come arrivare".
// Nelle pagine di un'area chiama direttamente quell'area; nelle pagine comuni
// "Chiama" apre un piccolo popover (attributo HTML nativo, senza JavaScript) con i due numeri.
import Icona from './Icona.astro';
import { centro } from '../lib/dati.js';

interface Props {
  area?: 'fitness' | 'medical';
}
const { area } = Astro.props;
const numero = area === 'medical' ? centro.medical : area === 'fitness' ? centro.area10 : null;
---

<nav class="barra" aria-label="Azioni rapide">
  {
    numero ? (
      <a class="barra__azione" href={`tel:${numero.telefono}`}>
        <Icona nome="phone" />
        <span>Chiama</span>
        <span class="visually-hidden">{`${numero.nomeBreve}, ${numero.telefonoLeggibile}`}</span>
      </a>
    ) : (
      <button class="barra__azione" type="button" popovertarget="barra-chiama">
        <Icona nome="phone" />
        <span>Chiama</span>
      </button>
    )
  }
  <a class="barra__azione barra__azione--mappa" href={centro.mappe.google} rel="noopener" target="_blank">
    <Icona nome="route" />
    <span>Come arrivare</span>
    <span class="visually-hidden">(apre Google Maps)</span>
  </a>
</nav>

{
  !numero && (
    <div id="barra-chiama" class="chiama" popover>
      <p class="chiama__titolo">Chi vuoi chiamare?</p>
      <a href={`tel:${centro.area10.telefono}`} data-tinta="fitness">
        <span class="chiama__area">Area10 Fitness Club</span>
        <span class="chiama__numero">{centro.area10.telefonoLeggibile}</span>
      </a>
      <a href={`tel:${centro.medical.telefono}`} data-tinta="medical">
        <span class="chiama__area">A10 Medical</span>
        <span class="chiama__numero">{centro.medical.telefonoLeggibile}</span>
      </a>
    </div>
  )
}

<style>
  .barra {
    position: fixed;
    inset: auto 0 0 0;
    z-index: var(--z-barra);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    padding: 0.5rem var(--gutter) calc(0.5rem + env(safe-area-inset-bottom));
    background-color: color-mix(in srgb, var(--sfondo) 92%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid var(--linea);
  }
  .barra__azione {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3rem;
    padding: 0 1rem;
    border: 0;
    border-radius: var(--raggio-btn);
    background-color: var(--cta-sfondo);
    color: var(--cta-testo);
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    cursor: pointer;
    transition: transform 160ms var(--ease-out);
  }
  .barra__azione:active {
    transform: scale(0.97);
  }
  .barra__azione--mappa {
    background-color: transparent;
    color: var(--testo);
    box-shadow: inset 0 0 0 1.5px var(--linea-forte);
  }
  .barra :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* popover con i due numeri, ancorato sopra la barra */
  .chiama {
    position: fixed;
    inset: auto var(--gutter) calc(4.75rem + env(safe-area-inset-bottom)) var(--gutter);
    margin: 0;
    width: auto;
    padding: 0.5rem;
    border: 1px solid var(--linea);
    border-radius: 1rem;
    background-color: var(--sfondo);
    color: var(--testo);
    box-shadow: 0 18px 40px -12px rgb(15 14 12 / 0.35);
    opacity: 1;
    transform: none;
    transform-origin: bottom center;
    transition:
      opacity 180ms var(--ease-out),
      transform 220ms var(--ease-out),
      overlay 220ms allow-discrete,
      display 220ms allow-discrete;
  }
  .chiama:not(:popover-open) {
    opacity: 0;
    transform: translateY(0.5rem) scale(0.98);
  }
  @starting-style {
    .chiama:popover-open {
      opacity: 0;
      transform: translateY(0.5rem) scale(0.98);
    }
  }
  .chiama__titolo {
    padding: 0.5rem 0.75rem 0.25rem;
    font-size: var(--step--1);
    color: var(--testo-2);
  }
  .chiama a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 3.25rem;
    padding: 0 0.75rem;
    border-radius: 0.6rem;
    text-decoration: none;
  }
  .chiama a:hover {
    background-color: var(--sfondo-2);
  }
  .chiama__area {
    font-weight: 650;
  }
  .chiama__numero {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--tinta-testo);
  }

  @media (min-width: 48em) {
    .barra,
    .chiama {
      display: none;
    }
  }
</style>
